# ToolLighthouse - backend. Copia este archivo a ".env" (NUNCA subas el .env al repositorio).
# Las variables de voz y de avisos (Fish, VOICE_*, HINT*, LOW_CONF, WS_*) se leen desde .env. La configuracion del
# detector (CONF, WEIGHTS, HOST, PORT, SERIAL_*, ...) sigue leyendose del entorno del proceso, como antes.
# Las variables reales del proceso tienen prioridad sobre este archivo.

# --- Fish Audio ---
FISH_API_KEY=
VOICE_ENABLED=true
VOICE_LANGUAGE=es
# Modelo gratuito por defecto. Si tienes plan de pago puedes cambiarlo (p. ej. s2-pro).
VOICE_MODEL=s2.1-pro-free
VOICE_REFERENCE_ID=
VOICE_REQUEST_TIMEOUT_SECONDS=15

# --- Cola y limites ---
VOICE_MAX_QUEUE_SIZE=20
VOICE_MAX_CONCURRENT_SYNTHESIS=1
# Segundos minimos entre anuncios de una misma sesion (429 + Retry-After si se incumple).
VOICE_MIN_INTERVAL_SECONDS=3
# Reintentos solo ante fallos transitorios (red / 5xx). Nunca ante timeout ni credenciales.
VOICE_MAX_RETRIES=1

# --- Acceso al backend (voz y avisos) ---
# Si se define, /voice/*, /hints/ticket y /hints/feedback exigen la cabecera X-Backend-Key con este valor
# (el proxy de Next.js la enviara). El WebSocket /ws/hints usa un ticket de un solo uso que se pide con esta clave.
# Generar una:  python -c "import secrets; print(secrets.token_urlsafe(32))"
# Vacia = sin autenticacion: aceptable SOLO con el backend en 127.0.0.1.
VOICE_BACKEND_KEY=
# Opcional: clave propia para los avisos (si no, se usa VOICE_BACKEND_KEY). Debe coincidir con la del Next.
# HINT_BACKEND_KEY=

# --- Avisos "Creo haber visto X" ---
# Con un valor invalido solo se desactivan los avisos (se registra el motivo); /detect sigue funcionando.
HINTS_ENABLED=true
# Piso de la banda de baja confianza (0.05 a CONF). Lo que queda entre LOW_CONF y CONF es "candidata".
LOW_CONF=0.30
# Estabilidad: la candidata debe aparecer en HINT_MIN_FRAMES de los ultimos HINT_WINDOW fotogramas.
# Desde el navegador llegan pocos FPS: con 3 FPS, 5 fotogramas son ~1.7 s. Bajalos para avisar antes.
HINT_WINDOW=10
HINT_MIN_FRAMES=5
# Esperas anti-repeticion (reloj real): por clase, global entre cualquier par de avisos, y crecimiento por repeticion
# sin confirmar (15, 30, 60, 120 s... con estos valores).
HINT_COOLDOWN_SECONDS=15
HINT_GLOBAL_COOLDOWN_SECONDS=10
HINT_BACKOFF_FACTOR=2
HINT_COOLDOWN_MAX_SECONDS=120
# Cuanto tiempo se puede reportar ("No es eso") o hablar un aviso despues de emitido.
HINT_REGISTRY_TTL_SECONDS=600

# --- Falsos positivos ("No es eso") ---
HINT_FEEDBACK_ENABLED=true
# Silencio de la clase tras reportarla (0 = solo registrar, sin silenciar).
HINT_FP_MUTE_SECONDS=600
HINT_FEEDBACK_LOG=data/hint_feedback.jsonl
# true guarda el JPEG del aviso reportado en data/hint_frames/ (imagenes de tu camara en disco: anade data/ al .gitignore).
HINT_SAVE_FRAMES=false

# --- WebSocket de avisos ---
# Origenes permitidos, exactos y separados por comas (sin comodines). Vacio = no se valida el origen.
# WS_ALLOWED_ORIGINS=https://tu-app.vercel.app,http://localhost:3000
WS_TICKET_TTL_SECONDS=30
WS_MAX_CLIENTS=8

# --- Opcionales (valores por defecto entre parentesis) ---
# VOICE_CACHE_MAX_ENTRIES=32
# VOICE_DEDUPE_TTL_SECONDS=120
# VOICE_DEDUPE_MAX_ENTRIES=64
# VOICE_MAX_AUDIO_BYTES=500000
