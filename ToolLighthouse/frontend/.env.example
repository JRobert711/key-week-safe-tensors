# Copia este archivo a .env.local. No subas .env.local al repositorio.
# Estas variables solo se leen en el servidor de Next.js (sin prefijo NEXT_PUBLIC_).
# Si cambias alguna, reinicia `next dev` / `next start` o vuelve a desplegar.

# URL base del backend. Si corre en otra máquina, 127.0.0.1 NO sirve:
# apunta a la máquina donde se ejecuta Next.js.
# Es opcional solo si activas ALLOW_CLIENT_BACKEND_URL.
BACKEND_URL=http://127.0.0.1:8000

# Ruta del backend que recibe la imagen (contrato actual: POST /detect).
BACKEND_DETECT_PATH=/detect

# Muestra en la página un campo para escribir la URL del backend.
# SOLO PARA PRUEBAS LOCALES: con true, cualquiera que abra la app puede hacer que
# el servidor de Next.js envíe peticiones a la URL que escriba. No lo actives en
# un despliegue accesible desde internet.
ALLOW_CLIENT_BACKEND_URL=true

# Tamaño máximo de imagen aceptado, en bytes (1 MiB por defecto).
MAX_UPLOAD_BYTES=1048576

# Tiempo máximo de espera al backend, en milisegundos.
# Mantenlo menor que el timeout del cliente (15 s en captureApi.ts).
BACKEND_TIMEOUT_MS=10000
