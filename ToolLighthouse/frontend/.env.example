# URL interna del backend FastAPI (solo servidor Next.js)
BACKEND_URL=http://127.0.0.1:8000

# Endpoint de detección existente
BACKEND_DETECT_PATH=/detect
MAX_UPLOAD_BYTES=1048576
BACKEND_TIMEOUT_MS=10000

# Fase 3: proxy de audio (la clave debe coincidir con VOICE_BACKEND_KEY del backend)
VOICE_AUDIO_PATH=/voice/audio
VOICE_BACKEND_KEY=
VOICE_BACKEND_TIMEOUT_MS=35000
VOICE_MAX_AUDIO_BYTES=500000
